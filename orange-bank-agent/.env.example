# Copiez ce fichier en `.env` puis remplacez les valeurs REPLACE_ME.
# Ne committez JAMAIS le fichier `.env`.

# --- LiteLLM : chat + embeddings (tous les appels LLM passent par LiteLLM) ---
LLM_API_KEY=REPLACE_ME
# URL de votre proxy LiteLLM (laisser REPLACE_ME si vous n'utilisez pas de proxy)
LLM_API_BASE=REPLACE_ME
# Noms de modèles au format LiteLLM (ex. gemini/..., openai/<alias-du-proxy>)
MODELE=gemini/<modèle>
MODELE_EMBEDDING=gemini/<modèle-embedding>

# --- Reranker Azure AI Foundry (OPTIONNEL — Brique 5) ---
RERANK_API_KEY=REPLACE_ME
RERANK_API_BASE=REPLACE_ME
MODELE_RERANK=azure_ai/<modèle-rerank>

# --- Langfuse (observabilité) ---
LANGFUSE_PUBLIC_KEY=REPLACE_ME
LANGFUSE_SECRET_KEY=REPLACE_ME
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optionnel : réglages d'indexation ---
# CHROMA_DIR=.chroma
# CHUNK_SIZE=700
# CHUNK_OVERLAP=100
